{
  "name": "STEP Viewer Demo",
  "short_name": "STEP Viewer",
  "description": "A zero-build, in-browser CAD file viewer for STEP, IGES, and BREP files with orbit controls, wireframe, and edge overlays.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#0e1116",
  "theme_color": "#0e1116",
  "icons": [
    {
      "src": "./icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "./icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ]
}
